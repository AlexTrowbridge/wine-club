# Copy to secrets.env (never commit it). Generate values with e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me
# Password for the default superuser "admin" (created on first deploy only; change it
# afterwards in the app). Set ADMIN_USERNAME in the configMap to use another name.
ADMIN_PASSWORD=change-me
